# TasteTrail-AI configuration (copy to .env and fill in values)

# Path to processed restaurant parquet (run scripts/ingest_data.py in Phase 1)
DATA_PATH=data/processed/restaurants.parquet

# Groq LLM (https://console.groq.com/keys)
LLM_PROVIDER=groq
LLM_API_KEY=your-groq-api-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Pipeline limits
MAX_CANDIDATES=20
DEFAULT_TOP_N=5

# Default minimum rating when user does not specify one
DEFAULT_MIN_RATING=3.0

# LLM request tuning
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
